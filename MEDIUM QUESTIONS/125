bool isPalindrome(char* s) {
   int left = 0;
    int right = strlen(s) - 1;

    while (left < right) {
        if (!isalnum(s[left])) {
            left++;                 // skip symbols on the left
        } else if (!isalnum(s[right])) {
            right--;                // skip symbols on the right
        } else if (tolower(s[left]) != tolower(s[right])) {
            return false;           // letters don't match
        } else {
            left++;                 // letters match, move inward
            right--;
        }
    }

    return true;
}
